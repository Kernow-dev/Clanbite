<?xml version="1.0"?>
<ruleset name="Clanbite">
	<description>
		PHPCS for the Clanbite core plugin: WordPress Coding Standards (Core + Docs + Security) and PHP 8.2 / WordPress
		compatibility, matching the companion plugins (Forums, Points, Ranks, Social Kit).
		Block render callbacks echo markup via wp_kses( ..., clanbite_block_fragment_allowed_html() ).
		{@see clanbite_esc_block_fragment_html()} remains a string helper for non-echo contexts.
	</description>

	<file>clanbite.php</file>
	<file>shortcut-function.php</file>
	<file>inc</file>
	<file>templates</file>
	<file>src</file>
	<arg name="extensions" value="php"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- `build/` is generated (webpack copies src/**/render.php); fix the source, not the copy. -->
	<exclude-pattern>*/build/*</exclude-pattern>

	<config name="minimum_supported_wp_version" value="6.9"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress.Security"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Classes are loaded through Composer's classmap / PSR-4 map, and several class names differ from their `class-*.php` file names; renaming files would break autoloading. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<!-- Escapes every attribute name and value internally (see inc/avatar-helpers.php). -->
			<property name="customEscapingFunctions" type="array">
				<element value="clanbite_build_html_attributes"/>
			</property>
		</properties>
	</rule>
</ruleset>
